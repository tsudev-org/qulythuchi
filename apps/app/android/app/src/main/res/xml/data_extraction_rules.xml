<?xml version="1.0" encoding="utf-8"?>
<!-- Không sao lưu đám mây / chuyển thiết bị: CSDL gắn với khóa Keystore của máy này, dữ liệu đi qua đồng bộ E2EE. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
