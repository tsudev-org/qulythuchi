---
// Thẻ có ô biểu tượng + nền hoạ tiết theo thể loại (DESIGN_SYSTEM.md mục 5 v6.0.0, phiếu UI2 B.3). Không dải viền màu
// trên đầu; sắc sản phẩm chỉ ở ô biểu tượng và viền khi rê. Hoạ tiết là CSS thuần (site.css `.the[data-hoa-tiet]`).
import type { BieuTuong } from '../lib/bieu-tuong';

type HoaTiet = 'luoi-cham' | 'giay-ke' | 'soc' | 'ban-co';
interface Props { tieuDe: string; bieuTuong: BieuTuong; hoaTiet: HoaTiet }
const { tieuDe, bieuTuong, hoaTiet } = Astro.props;
---
<div class="the the--hoa-tiet" data-hoa-tiet={hoaTiet} data-chuyen-dong={bieuTuong.chuyenDong}>
  <span class="the__bieu-tuong" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"
         stroke-linecap="round" stroke-linejoin="round" focusable="false" set:html={bieuTuong.duong} />
  </span>
  <h3>{tieuDe}</h3>
  <slot />
</div>
