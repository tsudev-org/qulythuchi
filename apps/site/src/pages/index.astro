---
import Trang from '../layouts/Trang.astro';

const diemManh = [
  ['Mã hóa đầu-cuối', 'Dữ liệu được mã hóa trên thiết bị bằng libsodium trước khi đồng bộ. Máy chủ chỉ giữ bản mã, không đọc được số tiền hay ghi chú của bạn.'],
  ['Ghi một câu là xong', 'Gõ hoặc nói "ăn trưa 50 nghìn", "hôm qua đổ xăng 80k": app tự tách số tiền, ngày, thu hay chi và gợi ý danh mục.'],
  ['Tự nhập từ ngân hàng', 'Đọc thông báo biến động số dư (Android), sao kê CSV/XLSX, hóa đơn bằng OCR trên máy. Mọi khoản vào hàng chờ để bạn xác nhận.'],
  ['Ngân sách và mục tiêu', 'Ngân sách theo kỳ và danh mục, 6 hũ, mục tiêu tiết kiệm, khoản định kỳ, hóa đơn có nhắc, sổ nợ, nhiều tiền tệ.'],
  ['Báo cáo dễ đọc', 'Thu chi theo kỳ so với kỳ trước, cơ cấu danh mục, tài sản ròng, lịch chi tiêu, "an toàn để tiêu". Biểu đồ nào cũng có bảng số.'],
  ['Dùng không cần tài khoản', 'Cài là dùng, dữ liệu nằm trên máy. Đăng nhập tài khoản tsudev chỉ khi muốn đồng bộ nhiều thiết bị.'],
];
---
<Trang moTa="Quly Thu Chi: app quản lý thu chi cá nhân mã hóa đầu-cuối, ghi nhanh bằng một câu, tự nhập từ ngân hàng, ngân sách, báo cáo. Có bản web." duongDan="/">
  <section class="hero khung">
    <span class="nhan">Một sản phẩm của tsudev</span>
    <h1>Quản lý thu chi, <span class="nhan-mau">chỉ bạn đọc được</span></h1>
    <p>Quly Thu Chi ghi lại từng khoản tiền vào ra, lập ngân sách và cho bạn thấy tiền đi đâu. Mọi dữ liệu được mã hóa
      ngay trên thiết bị: kể cả máy chủ đồng bộ của chúng tôi cũng không đọc được.</p>
    <div class="hang-nut">
      <a class="nut nut--chinh" href="/app/">Dùng ngay trên trình duyệt</a>
      <a class="nut nut--phu" href="/tai-ve/">Tải ứng dụng</a>
    </div>
  </section>

  <section class="muc">
    <div class="khung">
      <h2>Đủ cho tài chính cá nhân, không thừa</h2>
      <p class="dan">Chọn lọc từ những app quản lý chi tiêu phổ biến, bỏ quảng cáo và theo dõi, thêm mã hóa đầu-cuối.</p>
      <div class="luoi">
        {diemManh.map(([ten, moTa]) => <div class="the"><h3>{ten}</h3><p>{moTa}</p></div>)}
      </div>
      <p><a href="/tinh-nang/">Xem đầy đủ tính năng</a></p>
    </div>
  </section>

  <section class="muc">
    <div class="khung">
      <h2>Tiền là chuyện riêng</h2>
      <p class="dan">Ứng dụng tài chính biết nhiều về bạn hơn hầu hết mọi app khác. Vì vậy Quly Thu Chi được thiết kế để
        dữ liệu không rời tay bạn ở dạng đọc được.</p>
      <div class="luoi">
        <div class="the"><h3>Không quảng cáo, không theo dõi</h3><p>Không SDK quảng cáo, không phân tích hành vi, không bán dữ liệu.</p></div>
        <div class="the"><h3>Mã nguồn mở AGPL-3.0</h3><p>Ai cũng kiểm được cách mã hóa. Mọi bản phái sinh cũng phải công khai mã.</p></div>
        <div class="the"><h3>Khóa ứng dụng</h3><p>Mật khẩu, mã PIN hoặc sinh trắc; tự khóa khi rời app; che nội dung trong trình chuyển app.</p></div>
      </div>
      <p><a href="/bao-mat/">Bảo mật và quyền riêng tư</a></p>
    </div>
  </section>
</Trang>
