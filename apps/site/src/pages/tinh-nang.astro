---
import Trang from '../layouts/Trang.astro';

const nhom: [string, string[]][] = [
  ['Ghi chép', [
    'Ví tiền mặt, tài khoản ngân hàng, thẻ tín dụng (hạn mức còn lại), ví điện tử; chuyển tiền giữa ví kèm phí.',
    'Danh mục hai tầng có sẵn cho người Việt, sửa thoải mái; ghi chú, sự kiện (chuyến đi, đám cưới).',
    'Máy tính số tiền ngay trong ô nhập; số tiền luôn là số nguyên, không lệch một đồng.',
    'Tìm kiếm không dấu ("an trua" tìm ra "ăn trưa"), lọc nhiều điều kiện và lưu bộ lọc.',
  ]],
  ['Tự nhập', [
    'Ghi nhanh bằng một câu gõ hoặc nói: "nhận lương 15 triệu", "hai trăm rưỡi", "1tr2".',
    'Giọng nói nhận dạng trên máy; chỉ dùng dịch vụ của hệ điều hành khi bạn đồng ý từng lần.',
    'Quét hóa đơn bằng OCR trên máy (Android, iOS), ảnh không rời thiết bị.',
    'Đọc thông báo biến động số dư của app ngân hàng bạn chọn (chỉ Android).',
    'Nhập sao kê CSV/XLSX: tự tìm bảng giao dịch, cột ghi nợ/ghi có, bỏ dòng đã nhập.',
    'Email chuyển tiếp (tắt mặc định): địa chỉ riêng, máy chủ niêm phong thư ngay bằng khóa của bạn.',
    'Gợi ý danh mục học từ chính lịch sử của bạn, trên máy; cảnh báo khoản ghi trùng.',
  ]],
  ['Thu nhập, thuế và thanh toán', [
    'Số dư theo tháng: số dư đầu tháng chuyển từ tháng trước, thu, chi, số dư cuối tháng chuyển sang tháng sau.',
    'Cộng thu theo người trả, danh mục hoặc dự án; job freelance nhận nhiều đợt có đợt dự kiến, đã nhận, quá hạn.',
    'Thuế thu nhập cá nhân Việt Nam: ước tính quyết toán năm, tính lương gross/net, nhắc hạn quyết toán (tham khảo).',
    'Quét mã VietQR, kiểm mã bị sửa, mở app ngân hàng điền sẵn và ghi khoản chi; tạo mã nhận tiền của bạn.',
  ]],
  ['Kế hoạch', [
    'Ngân sách theo tuần, tháng, năm hoặc kỳ lương tùy ngày; theo danh mục hoặc ví; chuyển phần dư sang kỳ sau.',
    'Phương pháp 6 hũ chia thu nhập đúng tỉ lệ, tổng khớp từng đồng.',
    'Mục tiêu tiết kiệm với mức cần góp mỗi tháng; khoản định kỳ tự ghi hoặc chờ xác nhận.',
    'Hóa đơn có nhắc (thông báo không lộ số tiền), sổ nợ cho vay và đi vay.',
    'Mọi tiền tệ ISO 4217 với tỉ giá nhập tay, tổng quy đổi về tiền chính.',
  ]],
  ['Báo cáo và dữ liệu', [
    'Báo cáo theo kỳ so với kỳ trước, thu chi 6 tháng, cơ cấu danh mục, tài sản ròng, lịch chi tiêu.',
    '"An toàn để tiêu": còn tiêu được bao nhiêu mỗi ngày đến cuối kỳ.',
    'Xuất CSV, XLSX, PDF (có cảnh báo vì tệp xuất không mã hóa); sao lưu và khôi phục tệp .qtbak đã mã hóa.',
    'Chuyển từ app khác bằng tệp mẫu CSV/Excel: tự tạo ví, danh mục, nhận chuyển ví và bỏ dòng trùng.',
  ]],
  ['Đồng bộ và nền tảng', [
    'Dùng ngay không cần tài khoản; muốn đồng bộ thì tiếp tục với Google, GitHub hoặc tài khoản TsuDEV.',
    'Đồng bộ nhiều thiết bị qua tài khoản TsuDEV, hợp nhất theo từng trường khi sửa cùng lúc.',
    'Android, Windows, macOS, Linux và web; iPhone dùng bản web cài lên màn hình chính.',
    'Tiếng Việt và tiếng Anh, giao diện Sáng và Tối.',
  ]],
];
---
<Trang tieuDe="Tính năng" moTa="Tính năng của Quly Thu Chi: ví và danh mục, ghi nhanh bằng câu nói, tự nhập sao kê và thông báo ngân hàng, ngân sách, 6 hũ, báo cáo, đồng bộ." duongDan="/tinh-nang/">
  <div class="khung van-ban">
    <h1>Tính năng</h1>
    <p class="muc-luc">Mọi tính năng chạy được khi không có mạng và không cần tài khoản, trừ đồng bộ và email chuyển tiếp.</p>
    {nhom.map(([ten, ds]) => (
      <section>
        <h2>{ten}</h2>
        <ul class="danh-sach-kiem">{ds.map((d) => <li>{d}</li>)}</ul>
      </section>
    ))}
    <p><a class="nut nut--chinh" href="/app/">Dùng thử trên trình duyệt</a></p>
  </div>
</Trang>
