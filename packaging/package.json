{
  "schema": 1,
  "name": "qulythuchi",
  "winget": "tsudev.QulyThuChi",
  "publisher": "TsuDEV",
  "homepage": "https://qulythuchi.tsudev.com",
  "license": "AGPL-3.0-only",
  "description": {
    "vi": "Quản lý thu chi cá nhân mã hoá đầu cuối: ghi chép, ngân sách, mục tiêu, báo cáo, ví chung gia đình",
    "en": "End-to-end encrypted personal finance: transactions, budgets, goals, reports, shared family wallets"
  },
  "release": {
    "repo": "tsudev-org/qulythuchi",
    "tagRegex": "^v(?<version>[0-9]{2}\\.[1-9][0-9]?\\.[0-3][0-9][0-9]{2})$",
    "sums": "SHA256SUMS.txt"
  },
  "assets": {
    "windows-x64": {
      "file": "qulythuchi_{version}_windows-x64-portable.zip",
      "kind": "portable",
      "bin": "qulythuchi.exe",
      "shortcut": "Quly Thu Chi"
    },
    "linux-x64": {
      "file": "qulythuchi_{version}_linux-x64.tar.gz",
      "kind": "tar",
      "bin": "qulythuchi"
    },
    "linux-x64-deb": {
      "file": "qulythuchi_{version}_linux-x64.deb",
      "kind": "deb"
    },
    "macos-universal": {
      "file": "qulythuchi_{version}_macos-universal.zip",
      "kind": "zip-app",
      "app": "Quly Thu Chi.app"
    },
    "android-universal": {
      "file": "qulythuchi_{version}_android-universal.apk",
      "kind": "apk"
    }
  },
  "linux": {
    "command": "qulythuchi",
    "icon": "data/flutter_assets/assets/brand/logo-qulythuchi-256.png",
    "desktop": {
      "name": "Quly Thu Chi",
      "genericName": { "vi": "Quản lý thu chi", "en": "Personal finance" },
      "categories": ["GTK", "Office", "Finance"],
      "keywords": ["thu chi", "tài chính", "ngân sách", "finance", "budget"],
      "wmClass": "com.tsudev.qulythuchi"
    },
    "deb": {
      "depends": ["libc6 (>= 2.34)", "libgtk-3-0 | libgtk-3-0t64", "libsecret-1-0"],
      "section": "misc"
    },
    "rpm": {
      "depends": ["libgtk-3.so.0()(64bit)", "libsecret-1.so.0()(64bit)"],
      "group": "Applications/Productivity"
    }
  },
  "channels": [],
  "planned": ["scoop", "brew", "apt", "rpm", "winget", "msix"],
  "plannedNote": "Chỉ đăng ký kênh khi có bản chính thức đầu tiên (thẻ không -beta): Scoop/Homebrew đọc releases/latest, bỏ qua Pre-release. docs/RELEASE.md mục 6."
}
