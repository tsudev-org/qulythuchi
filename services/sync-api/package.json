{
  "name": "@qulythuchi/sync-api",
  "private": true,
  "description": "Máy chủ đồng bộ zero-knowledge của Quly Thu Chi trên Cloudflare Workers + D1 + R2: đăng nhập qua tsudev.com (OIDC), token cho app, đồng bộ bản mã, tệp đính kèm đã mã hóa",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "migrate:local": "wrangler d1 migrations apply qulythuchi --local",
    "migrate:remote": "wrangler d1 migrations apply qulythuchi --remote",
    "deploy": "node scripts/kiem-tinh.mjs && wrangler d1 migrations apply qulythuchi --remote && wrangler deploy",
    "postdeploy": "node ../../scripts/release-tag.mjs --from-deploy",
    "audit": "node scripts/audit.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "hono": "4.13.19",
    "jose": "6.2.17",
    "postal-mime": "4.2.1",
    "tweetnacl": "1.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261117.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.12",
    "wrangler": "4.164.0"
  },
  "packageManager": "npm@11.21.2",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261116.1": true
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.30.2",
    "@cloudflare/vitest-pool-workers": {
      "zod": "4.6.7",
      "wrangler": "4.163.0"
    }
  }
}
